   "expected": {
    "a": 13,
    "b": 11
   }
  },
  {
   "id": "q07",
   "tests": "rank within a partition",
   "question": "Who sold the most on each day?",
   "input": {
    "sales": [
     {
      "emp": "a",
      "day": 1,
      "sales": 5
     },
     {
      "emp": "b",
      "day": 1,
