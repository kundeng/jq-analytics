  {
   "id": "q10",
   "tests": "validity intervals; a lapsed lease; null when nobody holds it",
   "question": "Which device (mac) held address 10.0.0.5 at t = 1200, 6000 and 9100? ACK grants the address for `lease` seconds; RELEASE gives it up.",
   "input": {
    "dhcp": [
     {
      "ip": "10.0.0.5",
      "mac": "aa",
      "t": 1000,
      "msg": "ACK",
      "lease": 3600
     },
     {
      "ip": "10.0.0.5",
      "mac": "aa",
      "t": 5000,
      "msg": "RELEASE"
     },
     {
      "ip": "10.0.0.5",
      "mac": "bb",
      "t": 9000,
      "msg": "ACK",
      "lease": 3600
     }
    ]
   },
   "expected": {
    "1200": "aa",
    "6000": null,
    "9100": "bb"
   }
  }
 ]
