    "orders": [
     {
      "id": "o1",
      "cust": "c1"
     },
     {
      "id": "o2",
      "cust": "c9"
     },
     {
      "id": "o3",
      "cust": null
     }
    ],
    "customers": [
     {
      "cust": "c1"
     },
     {
      "cust": "c2"
     }
    ]
   },
   "expected": [
    "o2",
    "o3"
   ],
   "compare": "as a set"
  },
  {
   "id": "q09",
