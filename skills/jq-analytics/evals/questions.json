{
 "about": "Questions with known answers, for trying the skill on an agent that has only skills/jq-analytics/ and analytics.jq. The agent must answer by running jq with the library. `expected` is the answer in a neutral form; any output that states the same facts passes. The answers were produced with the library and checked by hand.",
 "questions": [
  {
   "id": "q01",
   "tests": "types before arithmetic; nulls skipped; group order",
   "question": "Mean RAM per site, and the number of hosts per site. RAM is text and one host has none.",
   "input": {
    "hosts": [
     {
      "host": "web01",
      "site": "North",
      "ram": "32",
      "seen": "2026-11-02 14:00:00"
     },
     {
      "host": "db01",
      "site": "South",
      "ram": "64",
      "seen": "2026-11-02 03:30:00"
     },
     {
      "host": "app01",
      "site": "North",
      "ram": "",
      "seen": "2026-11-01 05:30:00"
     },
     {
      "host": "app02",
      "site": "North",
      "ram": "16",
      "seen": ""
     }
    ]
   },
   "expected": [
    {
     "site": "North",
     "hosts": 3,
     "mean_ram": 24
    },
    {
     "site": "South",
     "hosts": 1,
     "mean_ram": 64
    }
   ]
  },
  {
   "id": "q02",
   "tests": "time zone, not the process zone; day boundary; switch to winter time",
   "question": "On which local date in America/Detroit was each host last seen? The text is UTC. Leave out hosts never seen.",
   "input": {
    "hosts": [
     {
      "host": "web01",
      "site": "North",
      "ram": "32",
      "seen": "2026-11-02 14:00:00"
     },
     {
      "host": "db01",
      "site": "South",
      "ram": "64",
      "seen": "2026-11-02 03:30:00"
     },
     {
      "host": "app01",
      "site": "North",
      "ram": "",
      "seen": "2026-11-01 05:30:00"
     },
     {
      "host": "app02",
      "site": "North",
      "ram": "16",
      "seen": ""
     }
    ]
   },
   "expected": {
    "web01": "2026-11-02",
    "db01": "2026-11-01",
    "app01": "2026-11-01"
   }
  },
  {
   "id": "q03",
   "tests": "funnel",
   "question": "How many users reached each of the steps view, cart, pay, in that order?",
   "input": {
    "events": [
     {
      "user": "u1",
      "t": 10,
      "step": "view"
     },
     {
      "user": "u1",
      "t": 20,
      "step": "cart"
     },
     {
      "user": "u1",
      "t": 30,
      "step": "pay"
     },
     {
      "user": "u2",
      "t": 5,
      "step": "view"
     },
     {
      "user": "u2",
      "t": 50,
      "step": "cart"
     },
     {
      "user": "u3",
      "t": 7,
      "step": "view"
     }
    ]
   },
   "expected": {
    "view": 3,
    "cart": 2,
    "pay": 1
   }
  },
  {
   "id": "q04",
   "tests": "graph direction: reverse reachability",
   "question": "If db goes down, which services are affected, directly or through others? An edge from X to Y means X depends on Y.",
   "input": {
    "deps": [
     {
      "from": "web",
      "to": "api"
     },
     {
      "from": "api",
      "to": "db"
     },
     {
      "from": "batch",
      "to": "db"
     },
     {
      "from": "db",
      "to": "disk"
     }
    ]
   },
   "expected": [
    "api",
    "batch",
    "web"
   ],
   "compare": "as a set"
  },
  {
   "id": "q05",
   "tests": "dependency order",
   "question": "Give an order in which the services can be started so that each starts after everything it depends on. An edge from X to Y means X depends on Y.",
   "input": {
    "deps": [
     {
      "from": "web",
      "to": "api"
     },
     {
      "from": "api",
      "to": "db"
     },
     {
      "from": "batch",
      "to": "db"
     },
     {
      "from": "db",
      "to": "disk"
     }
    ]
   },
   "expected": "any order with disk before db, db before api and batch, api before web",
   "check": "order constraints"
  },
  {
