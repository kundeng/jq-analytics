# ---------------------------------------------------------------- end of tzdata

# ---------------------------------------------------------------- math: arrays of numbers

# the input array without nulls
def nonnull: map(select(. != null));

# number of non-null values
def count_nonnull: nonnull | length;

# sum of non-null values; null when there are none (jq's add returns null for [] but counts nothing)
def sum_nonnull: nonnull | if length == 0 then null else add end;

# arithmetic mean of non-null values; null when none. Plain `add / length` divides by a count
# that includes nulls: [1, null, 3] gives 1.33 there and 2 here.
def mean: nonnull | if length == 0 then null else add / length end;

# least and greatest non-null value; null when none, as SQL's MIN and MAX. jq's own min and max do
# not skip nulls: null sorts below every number, so [null, 1, 3] | min is null there and 1 here.
def min_nonnull: nonnull | min;
def max_nonnull: nonnull | max;

# the row whose f is least (greatest), rows with a null f left out; null when none (SQL ARG_MIN,
# ARG_MAX). Ties: the first such row for min, the last for max, as jq's min_by and max_by.
def min_by_nonnull(f): map(select((f) != null)) | min_by(f);
def max_by_nonnull(f): map(select((f) != null)) | max_by(f);

# variance and standard deviation: sample (divide by n - 1, null below 2 values) and population
# (divide by n, null when none). Two-pass: mean first, then squared deviations.
def var_samp: nonnull | length as $n
  | if $n < 2 then null else (add / $n) as $m | (map((. - $m) * (. - $m)) | add) / ($n - 1) end;
def var_pop: nonnull | length as $n
  | if $n == 0 then null else (add / $n) as $m | (map((. - $m) * (. - $m)) | add) / $n end;
def stddev_samp: var_samp | if . == null then null else sqrt end;
def stddev_pop: var_pop | if . == null then null else sqrt end;

# Quantiles over non-null values, p in [0, 1]; null when none.
# quantile_disc: nearest rank, an element of the data: the value at 1-based rank ceil(n * p) of the
#   sorted values, at least rank 1. DuckDB's quantile_disc gives the same (checked by the tests).
# quantile_cont: linear interpolation at h = (n - 1) * p between the neighbours of h, the rule of
#   DuckDB's quantile_cont and median, Excel PERCENTILE.INC and Power Query PercentileMode.ExcelInc.
def quantile_disc($p): nonnull | sort as $x | length as $n
  | if $n == 0 then null else $x[([(($n * $p) | ceil), 1] | max) - 1] end;
def quantile_cont($p): nonnull | sort as $x | length as $n
  | if $n == 0 then null
    else (($n - 1) * $p) as $h | ($h | floor) as $lo
    | if $lo + 1 >= $n then $x[$lo] else $x[$lo] + ($h - $lo) * ($x[$lo + 1] - $x[$lo]) end
    end;
def median: quantile_cont(0.5);
# several quantiles at once, as DuckDB's list form: null (not a list of nulls) when no values
def quantiles_disc($ps): if count_nonnull == 0 then null else [$ps[] as $p | quantile_disc($p)] end;
def quantiles_cont($ps): if count_nonnull == 0 then null else [$ps[] as $p | quantile_cont($p)] end;

# round to $d decimal places, halves away from zero, on the binary double (so 1.005 becomes 1.0,
# because 1.005 is stored as 1.00499999...). Null stays null.
def round_to($d): if . == null then null else pow(10; $d) as $m | (. * $m | round) / $m end;

# ---------------------------------------------------------------- types

# "YYYY-MM-DDTHH:MM:SSZ" to epoch seconds, refusing a date or time that does not exist. Some engines
# accept 2026-02-30 and carry it over to 2 March; printing the result back and comparing catches
# that on every engine. $s is the caller's original text, for the message.
def _ts_exact($s):
  . as $iso | (try ($iso | fromdateiso8601) catch null) as $e
  | if $e == null or ($e | todate) != $iso then error("parse_ts: not a timestamp: \($s | tojson)") else $e end;

# a timestamp string to UTC epoch seconds (fractions kept). Accepts "YYYY-MM-DD HH:MM:SS" or "T",
# optional fraction, optional "Z" or +HH:MM / +HHMM offset. No offset means UTC (as ServiceNow
# and Splunk's _time strings store it). null and "" give null; anything else is an error, never
# a silent empty: that includes a date or time that does not exist, such as 30 February.
# Unlike strptime("%z"), the offset is applied.
# Fast path: the common 19-character form ("2026-08-12 13:05:00") skips the regex, which was most of
# the cost (at 500,000 rows in the Python jq package, 24.7 s with the regex, 7.5 s without); its
# dashes, colons and digits are still checked, by fromdateiso8601's own format, and a bad one is the
# same error.
def parse_ts:
  if . == null or . == "" then null
  elif length == 19 and (.[10:11] | . == " " or . == "T")
  then . as $s | (.[0:10] + "T" + .[11:19] + "Z") | _ts_exact($s)
  else . as $s
    | (capture("^(?<d>[0-9]{4}-[0-9]{2}-[0-9]{2})[T ](?<t>[0-9]{2}:[0-9]{2}:[0-9]{2})(?<f>[.][0-9]+)?(?<z>Z|[+-][0-9]{2}:?[0-9]{2})?$")
       // error("parse_ts: not a timestamp: \($s | tojson)")) as $m
    | ("\($m.d)T\($m.t)Z" | _ts_exact($s))
      + (if $m.f == null then 0 else ("0" + $m.f | tonumber) end)
      - (if $m.z == null or $m.z == "Z" then 0
         else ($m.z | sub(":"; "")) as $z
         | (($z[1:3] | tonumber) * 3600 + ($z[3:5] | tonumber) * 60) * (if $z[0:1] == "-" then -1 else 1 end)
         end)
  end;

# cast the named columns of every row. $schema = {column: "number" | "timestamp" | "string" | "boolean"}.
# "" and null become null. A value that does not parse is an error naming the column and value
# (Power Query's rule), never a null. Numbers must look like JSON numbers: jq 1.7.1's tonumber
# accepts " 12" and jq 1.8's refuses it, so the pattern decides instead of the version.
# A schema column that a row lacks is added to it as null, so every row comes out with the same columns.
def cast_columns($schema):
  map(reduce ($schema | to_entries[]) as $c (.;
    .[$c.key] |= (
      if . == null or . == "" then null
      elif $c.value == "number" then
        (if type == "number" then .
         elif type == "string" and test("^-?[0-9]+([.][0-9]+)?([eE][-+]?[0-9]+)?$") then tonumber
         else error("cast_columns: \($c.key) = \(tojson) is not a number") end)
      elif $c.value == "timestamp" then parse_ts
      elif $c.value == "string" then tostring
      elif $c.value == "boolean" then
        (if . == true or . == "true" then true elif . == false or . == "false" then false
         else error("cast_columns: \($c.key) = \(tojson) is not a boolean") end)
      else error("cast_columns: unknown type \($c.value | tojson) for \($c.key)") end)));

# ---------------------------------------------------------------- time zones and calendar

# the transition rules of one IANA zone, from the generated tzdata block above (from the tzdata package; covers
# 1970 to 2100). Unknown zone is an error. No process TZ is read anywhere in this file.
# tz_rules is a 27 KB literal that jq rebuilds on every call (0.8 ms), so a program that converts
# many rows looks the zone up once: tz("America/Detroit") as $det | ... | local_time($det).
def tz($name): tz_rules[$name] // error("tz: zone not in the zone tables: \($name)");

# UTC offset in seconds at the input epoch; $tz is a zone name or the object tz($name) returned
def tz_offset($tz):
  . as $e
  | ($tz | if type == "string" then tz(.) else . end)
  | (.t | bsearch($e)) as $i
  | .o[if $i >= 0 then $i else -2 - $i end];

# the local wall clock of the input epoch in zone $tz (a name or tz($name)), as an object:
# {date: "YYYY-MM-DD", year, month (1-12), day, hour, minute, second, weekday (0 = Sunday),
#  offset_s, local_epoch (epoch of the wall clock read as if it were UTC)}
def local_time($tz):
  tz_offset($tz) as $o | (. + $o) as $l | ($l | floor | gmtime) as $g
  | {date: ($g | strftime("%Y-%m-%d")), year: $g[0], month: ($g[1] + 1), day: $g[2],
     hour: $g[3], minute: $g[4], second: ($g[5] + ($l - ($l | floor))), weekday: $g[6],
     offset_s: $o, local_epoch: $l};

# hours from epoch a to epoch b, exact (no rounding); null when either is null
def hours_between(a; b): (a) as $a | (b) as $b
  | if $a == null or $b == null then null else ($b - $a) / 3600 end;

# ---------------------------------------------------------------- grouping

# rows grouped by f: an array of groups in order of first appearance, each group in input order.
# Built on the builtin group_by (a stable sort), then put back in first-appearance order by each
# group's first input position. Appending rows to groups inside a reduce is avoided everywhere in
# this file: it grows with the square of a group's size (measured: 40 times the time for 10 times
# the rows), and an object's key order differs between engines (gojq sorts keys).
def _groups(f): to_entries | group_by(.value | f) | sort_by(.[0].key) | map(map(.value));

# group rows by keyf and aggregate each group with aggf (applied to the group's array of rows).
# Output: one row per group, in order of first appearance (group_by sorts by key instead).
# A key that is an object is merged into the output row; any other key goes in field "key".
# aggf must return an object. Null keys form one group, as in SQL GROUP BY.
def group_agg(keyf; aggf):
  _groups(keyf) | map((.[0] | keyf | if type == "object" then . else {key: .} end) + aggf);

# ---------------------------------------------------------------- several tables at once

# Name each table with `as $name` and refer to it later by that name, as SPL2 names its searches:
#   split_by(.event_type) as $by_type | ($by_type.dhcp | map(...)) as $leases | ...
# split_by, keep_tables and shape below work on an object of tables: {dhcp: [...], firewall: [...]}.

# split a stream of rows into an object of tables by a tag: rows with the same tagf value form one table,
# named by that value as a string (a null tag gives the table "null"). A host that can pass only one
# stream hands over several tables this way: one stream, with a field saying which table each row belongs to.
# Two different tags with the same name as text (1 and "1", or null and "null") are an error: one
# table would otherwise replace the other.
def split_by(tagf):
  [_groups(tagf)[] | {key: (.[0] | tagf | tostring), tag: (.[0] | tagf), value: .}]
  | (group_by(.key) | map(select(length > 1))[0]) as $dup
  | if $dup != null
    then error("split_by: tags \($dup[0].tag | tojson) and \($dup[1].tag | tojson) give the same table name \($dup[0].key | tojson)")
    else map({key, value}) | from_entries end;

# keep only the named tables (drop the rest before a heavy step or before output)
def keep_tables($names): with_entries(select(.key as $k | $names | any(. == $k)));

# for checking a pipeline midway: each table's row count and field names (sorted)
def shape: map_values({rows: length, fields: (map(keys) | add // [] | unique)});

# ---------------------------------------------------------------- joins

# Every join is four choices:
#   key   - lkey and rkey, the equality part: any expression per side, an array for a composite key.
#           The right table is indexed once by rkey, so cost is left rows + right rows.
#           For a join with no equality part, pass `true` for both keys: every pair is then checked.
#   cond  - the rest of the match, a filter over the pair {l: left row, r: right row}; `true` for none.
#           It is checked only for pairs that share a key.
#   kind  - "inner", "left", "full", "semi" or "anti".
#   shape - flat (join_on: one output row per match) or nested (join_nest: matches as an array).
# Rules for all: a null key never matches. Duplicate keys multiply rows in a flat join. Output
# follows the left table's order, then the right table's order among matches, on every engine.
# A flat match is the left row with the right row's fields added. A field name that both tables
# have is kept twice: the left one under its name, the right one under name + suffix ("_right"
# unless join_on is given another), in every output row, whether or not the two values agree.
# The exception is a field both keys read directly (`.host` and `.host`, `{site, host}` on both
# sides, the same position of two arrays): it is equal in every match, so it appears once.
# A suffixed name that already exists in either table is an error: pass another suffix.
# A null suffix gives the strict rule instead: a shared field with the same value is kept once,
# and with different values it is an error naming the field.

# the field names lkey and rkey both read directly, at the same place of the key
def _key_fields($lnames; $rnames; lkey; rkey):
  def probe: map({key: ., value: {"\u0000field": .}}) | from_entries;
  def marks: [paths as $p | getpath($p) as $v
              | select(($v | type) == "object" and ($v | length) == 1 and ($v | has("\u0000field")))
              | {p: $p, f: $v["\u0000field"]}];
  (try ([$lnames | probe | lkey] | marks) catch []) as $a
  | (try ([$rnames | probe | rkey] | marks) catch []) as $b
  | [$a[] as $x | $b[] | select(.p == $x.p and .f == $x.f) | .f] | unique;

# the plan for merging rows of two tables: {strict}, or {keys: {name: true}, names: {name: new name}}
def _merge_plan($left; $right; lkey; rkey; $suffix):
  if $suffix == null then {strict: true}
  elif ($suffix | type) != "string" or $suffix == "" then error("join: the suffix must be a non-empty string, or null for the strict rule")
  else
    ([$left[] | keys[]] | unique) as $ln
    | ([$right[] | keys[]] | unique) as $rn
    | _key_fields($ln; $rn; lkey; rkey) as $k
    | ($ln - ($ln - $rn) - $k) as $shared
    | ($shared | map(. + $suffix)) as $new
    | (($new - ($new - ($ln + $rn)))[0]) as $taken
    | if $taken != null
      then error("join: field \($taken | tojson) already exists, so the right table's \($taken | rtrimstr($suffix) | tojson) cannot take that name; pass another suffix")
      else {keys: ($k | map({key: ., value: true}) | from_entries),
            names: ([$shared, $new] | transpose | map({key: .[0], value: .[1]}) | from_entries)}
      end
  end;

def _merge($l; $r; $plan):
  if $plan.strict then
    reduce ($r | to_entries[]) as $e ($l;
      if has($e.key) and .[$e.key] != $e.value
      then error("join: field \($e.key | tojson) differs between left (\(.[$e.key] | tojson)) and right (\($e.value | tojson)); rename one side first")
      else .[$e.key] = $e.value end)
  else
    reduce ($r | to_entries[]) as $e ($l;
      if $plan.keys[$e.key] then (if has($e.key) then . else .[$e.key] = $e.value end)
      else .[$plan.names[$e.key] // $e.key] = $e.value end)
  end;

# each left row with its matching right rows: [{l: row, m: [{key: right position, value: right row}]}]
def _matches($right; lkey; rkey; cond):
  ($right | to_entries | group_by(.value | rkey)
   | map(select((.[0].value | rkey) != null) | {key: (.[0].value | rkey | tojson), value: .}) | from_entries) as $ix
  | [.[] as $l | ($l | lkey) as $k
     | {l: $l, m: [(if $k == null then empty else $ix[$k | tojson][]? end)
                   | select(.value as $r | {l: $l, r: $r} | cond)]}];

# the general flat join; $suffix goes on the right table's shared field names ("_right" by default), null = the strict rule
def join_on($right; lkey; rkey; cond; $kind; $suffix):
  . as $left
  | (if $kind == "inner" or $kind == "left" or $kind == "full" then _merge_plan($left; $right; lkey; rkey; $suffix) else null end) as $plan
  | _matches($right; lkey; rkey; cond) as $rows
  | if $kind == "inner" then [$rows[] | .l as $l | .m[] | _merge($l; .value; $plan)]
    elif $kind == "left" then [$rows[] | .l as $l | if (.m | length) > 0 then .m[] | _merge($l; .value; $plan) else $l end]
    elif $kind == "semi" then [$rows[] | select((.m | length) > 0) | .l]
    elif $kind == "anti" then [$rows[] | select((.m | length) == 0) | .l]
    elif $kind == "full" then
      # right rows that matched no left row follow the left part, in right order, with their
      # shared fields under the suffixed names like every other row
      ([$rows[].m[] | {key: (.key | tostring), value: true}] | from_entries) as $hit
      | [$rows[] | .l as $l | if (.m | length) > 0 then .m[] | _merge($l; .value; $plan) else $l end]
        + [$right | to_entries[] | select($hit[.key | tostring] | not) | .value
           | if $plan.strict then . else _merge({}; .; $plan) end]
    else error("join_on: unknown kind \($kind | tojson)") end;
def join_on($right; lkey; rkey; cond; $kind): join_on($right; lkey; rkey; cond; $kind; "_right");

# equality joins: join_on with no condition; semi and anti return left rows only, with no right fields
def join_inner($right; lkey; rkey): join_on($right; lkey; rkey; true; "inner");
def join_left($right; lkey; rkey): join_on($right; lkey; rkey; true; "left");
def join_full($right; lkey; rkey): join_on($right; lkey; rkey; true; "full");
def join_semi($right; lkey; rkey): join_on($right; lkey; rkey; true; "semi");
def join_anti($right; lkey; rkey): join_on($right; lkey; rkey; true; "anti");

# nested join: every left row once, with field $as holding the array of its matching right rows
# (empty when none). Never multiplies rows. Power Query's Table.NestedJoin.
def join_nest($right; lkey; rkey; cond; $as):
  [_matches($right; lkey; rkey; cond)[] | .l + {($as): [.m[].value]}];

# lookup: attach exactly one record of a dimension table under field $as (null when none).
# A key that appears twice in the dimension is an error, so a lookup can never multiply rows.
def lookup($dim; lkey; dkey; $as):
  ($dim | group_by(dkey)
   | map(select((.[0] | dkey) != null)
         | if length > 1 then error("lookup: key \(.[0] | dkey | tojson) appears more than once in the dimension")
           else {key: (.[0] | dkey | tojson), value: .[0]} end)
   | from_entries) as $ix
  | map(. as $l | ($l | lkey) as $k | $l + {($as): (if $k == null then null else $ix[$k | tojson] end)});

# interval overlap: pairs with the same key whose intervals overlap, each interval closed at its
# start and open at its end ([start, end)). Flat and inner; a start or end field named the same on
# both sides comes out twice, the right one with "_right".
def join_overlap($right; lkey; rkey; lstart; lend; rstart; rend):
  join_on($right; lkey; rkey; (.l | lstart) < (.r | rend) and (.r | rstart) < (.l | lend); "inner");

# As-of join (left outer): for each left row, the right row with the same key whose rtime is the
# greatest rtime <= the left row's ltime (DuckDB's ASOF LEFT JOIN ... ON l.k = r.k AND l.t >= r.t).
# $max_age, when not null, rejects a match older than that: ltime - rtime must be <= $max_age.
# Ties on rtime: the first such right row in input order (DuckDB 2.0.0 gave the same on the test
# fixture; pandas merge_asof takes the last; SQL leaves it open). No match, or a null key or time
# on the left: the left row alone. Right rows with a null key or time are dropped.
def join_asof($right; lkey; rkey; ltime; rtime; $max_age):
  _merge_plan(.; $right; lkey; rkey; "_right") as $plan
  | ([$right[] | select((rkey) != null and (rtime) != null)] | group_by(rkey)
   | map({key: (.[0] | rkey | tojson), value: (sort_by(rtime) | {rows: ., t: map(rtime)})}) | from_entries) as $ix
  | [.[] as $l | ($l | lkey) as $k | ($l | ltime) as $t
     | if $k == null or $t == null or $ix[$k | tojson] == null then $l
       else $ix[$k | tojson] as $g
       | ($g.t | bsearch($t)) as $i
       # bsearch gives some entry equal to $t, or the insertion point; take the last entry <= $t,
       # then step back to the first of its run of equal times
       | (if $i >= 0 then $i else -2 - $i end) as $last
       | (if $last < 0 then -1 else $last | until(. == 0 or $g.t[. - 1] != $g.t[$last]; . - 1) end) as $j
       | if $j < 0 or ($max_age != null and $t - $g.t[$j] > $max_age) then $l else _merge($l; $g.rows[$j]; $plan) end
       end];
def join_asof($right; lkey; rkey; ltime; rtime): join_asof($right; lkey; rkey; ltime; rtime; null);

# ---------------------------------------------------------------- windows

# Window over partitions: split rows by part (first appearance), sort each partition by ord
# (stable: ties keep input order), call wf on the sorted partition (an array of rows), which must
# return an array of the same length, and write its i-th value into field $col of the i-th row.
# Rows come back in input order. Frames are ROWS frames (each row by itself), not SQL's default
# RANGE frame, which gives tied rows the same running value.
def window(part; ord; $col; wf):
  . as $rows
  | [to_entries | map({i: .key, r: .value}) | group_by(.r | part)[]
     | sort_by(.r | ord) | (map(.r) | wf) as $v | to_entries[] | {i: .value.i, v: $v[.key]}]
  | sort_by(.i) | map(.v) as $vals
  | [$rows | to_entries[] | .value + {($col): $vals[.key]}];

# window value functions: input is one sorted partition (array of rows)
def row_number: [range(1; length + 1)];
# rank with gaps (SQL RANK) by f over the partition's order: tied f values share a rank
# (a row's rank is its position plus one, minus the earlier rows that share its value; grouping
# once gives that count for every row, where counting per row took the square of the partition)
def rank_by(f):
  [to_entries | group_by(.value | f)[] | to_entries[] | {i: .value.key, r: (.value.key + 1 - .key)}]
  | sort_by(.i) | map(.r);
def lag(f; $k): . as $a | [range(length) as $i | if $i - $k >= 0 then ($a[$i - $k] | f) else null end];
def lead(f; $k): . as $a | length as $n | [range($n) as $i | if $i + $k < $n then ($a[$i + $k] | f) else null end];
# running sum of f, ROWS frame from the partition start: nulls skipped; null until the first non-null
def running_sum(f): [foreach .[] as $r (null; ($r | f) as $v | if $v == null then . else (. // 0) + $v end; .)];
# moving mean of f over the current row and the $n - 1 rows before it (fewer at the start); nulls skipped
def moving_mean(f; $n): . as $a | [range(length) as $i | [$a[([$i - $n + 1, 0] | max):($i + 1)][] | f] | mean];

# ---------------------------------------------------------------- reshape

# unpivot: every field not in $keep becomes its own row {keep fields..., $name: field, $value: value}.
# Null values are kept (Power Query's example drops them). Within a row, fields come out sorted by
# name, so every engine agrees (jq and jaq keep insertion order, gojq sorts keys).
def unpivot($keep; $name; $value):
  [.[] as $r | ($r | with_entries(select(.key as $k | $keep | any(. == $k)))) as $base
   | $r | to_entries | sort_by(.key)[] | select(.key as $k | $keep | any(. == $k) | not)
   | $base + {($name): .key, ($value): .value}];

# pivot: one output row per rowkey (an object) and one column per name in $cols (Power Query's
# pivotValues), holding agg applied to the array of valf values whose colf (as a string) is that
# name. A name with no matching rows gives null; colf values not in $cols are dropped.
def pivot($cols; rowkey; colf; valf; agg):
  group_agg(rowkey; (group_by(colf | tostring) | map({key: (.[0] | colf | tostring), value: map(valf)}) | from_entries) as $cells
    | reduce $cols[] as $c ({}; .[$c] = ($cells[$c] | if . == null then null else agg end)));

# ---------------------------------------------------------------- state machines over time

# Events of one entity, ordered by time, are read as a machine that is in one state at a time.

# an event with a null time cannot be placed in time: an error naming the calling function
def _time_check(time; $who): if any(.[]; (time) == null) then error("\($who): an event has no time") else . end;

# the blocks of one entity's events, already sorted by time
def _blocks(time; state):
  # positions where a new block starts, then each block from its start to the next start
  . as $a | length as $n
  | [range($n) | select(. == 0 or (($a[.] | state) != ($a[. - 1] | state)))] as $st
  | [range($st | length) as $j | $st[$j] as $i
     | (if $j + 1 < ($st | length) then $st[$j + 1] else null end) as $nx
     | ($a[$i] | time) as $t0 | (if $nx == null then null else ($a[$nx] | time) end) as $t1
     | {state: ($a[$i] | state), start: $t0, end: $t1,
        duration: (if $t1 == null then null else $t1 - $t0 end),
        events: ((if $nx == null then $n else $nx end) - $i)}];
# state_blocks: per entity, events sorted by time (stable), consecutive events with the same state
# merged into one block: {entity key..., state, start (time of its first event), end (time of the
# next block's first event, null for the entity's last block), duration (end - start, null when
# open), events (how many events it merged)}. A repeated state does not restart the clock: an
# assignee change while the status stays Open is still the same Open block. The entity key is
# merged in as group_agg does (an object key's fields, or field "key"). Order: entities by first
# appearance, blocks by time. An event with a null time is an error.
def state_blocks(entity; time; state):
  _time_check(time; "state_blocks")
  | group_agg(entity; {blocks: (sort_by(time) | _blocks(time; state))})
  | [.[] | del(.blocks) as $k | .blocks[] | $k + .];

# transitions: one row per change of state: {entity key..., from, to, at (time of the change)}
def transitions(entity; time; state):
  _time_check(time; "transitions")
  | group_agg(entity; {blocks: (sort_by(time) | _blocks(time; state))})
  | [.[] | del(.blocks) as $k | .blocks as $b | range(1; $b | length) as $i
     | $k + {from: $b[$i - 1].state, to: $b[$i].state, at: $b[$i].start}];

# sessions: per entity, events sorted by time; a new session starts when the gap since the previous
# event is greater than $gap. Rows: {entity key..., session (1, 2, ... within the entity), start,
# end (time of its last event), events}.
def sessions(entity; time; $gap):
  _time_check(time; "sessions")
  | group_agg(entity; {sessions: (sort_by(time) | . as $a | length as $n
      | [range($n) | select(. == 0 or (($a[.] | time) - ($a[. - 1] | time)) > $gap)] as $st
      | [range($st | length) as $j | $st[$j] as $i
         | (if $j + 1 < ($st | length) then $st[$j + 1] else $n end) as $nx
         | {session: ($j + 1), start: ($a[$i] | time), end: ($a[$nx - 1] | time), events: ($nx - $i)}])})
  | [.[] | del(.sessions) as $k | .sessions[] | $k + .];

# runs: run-length encoding of an array in its given order: consecutive items with the same f value
# become {value, start (0-based position of the first), n}. Streaks are the long runs.
def runs(f):
  . as $a | length as $n
  | [range($n) | select(. == 0 or (($a[.] | f) != ($a[. - 1] | f)))] as $st
  | [range($st | length) as $j | $st[$j] as $i
     | {value: ($a[$i] | f), start: $i, n: ((if $j + 1 < ($st | length) then $st[$j + 1] else $n end) - $i)}];

# ---------------------------------------------------------------- hierarchies

# A tree is a table of nodes, each naming its parent; a root's parent is null or "".

# tree_paths: adds to every node `ancestry` (the ids from its root down to itself) and `depth`
# (0 for a root). A parent id that is not a node, a cycle, or an id on two rows is an error.
# Each node's ancestry is built once: a walk up stops at the first ancestor already done and the
# ancestries are then filled in from there down, so the cost follows the size of the output, not
# the square of the depth.
def tree_paths(id; parent):
  (reduce .[] as $n ({}; ($n | id | tojson) as $k
     | if has($k) then error("tree_paths: id \($k) appears twice") else .[$k] = [($n | parent)] end)) as $par
  | (reduce .[] as $n ({m: {}};
       ($n | id) as $i
       | if .m[$i | tojson] != null then .
         else .chain = [$i] | .on = {($i | tojson): true} | .cur = $i
           | until($par[.cur | tojson][0] as $p | $p == null or $p == "" or .m[$p | tojson] != null;
               $par[.cur | tojson][0] as $p
               | if $par[$p | tojson] == null then error("tree_paths: parent \($p | tojson) is not a node")
                 elif .on[$p | tojson] then error("tree_paths: cycle through \($p | tojson)")
                 else .chain += [$p] | .on[$p | tojson] = true | .cur = $p end)
           | $par[.cur | tojson][0] as $top
           | .a = (if $top == null or $top == "" then [] else .m[$top | tojson] end)
           | reduce (.chain | reverse)[] as $c (.; .a += [$c] | .m[$c | tojson] = .a)
         end) | .m) as $anc
  | map(. + ($anc[id | tojson] | {ancestry: ., depth: (length - 1)}));

# tree_rollup: tree_paths, plus `subtree`: the node's own value plus the values of all its
# descendants, at any depth. A null value counts as 0.
def tree_rollup(id; parent; value):
  tree_paths(id; parent) as $t
  | (reduce $t[] as $n ({}; ($n | value) as $v
       | reduce $n.ancestry[] as $a (.; .[$a | tojson] += ($v // 0)))) as $sum
  | $t | map(. + {subtree: $sum[id | tojson]});

# ---------------------------------------------------------------- graphs

# A graph is a table of edges; from and to (or a and b) are expressions giving each edge's two ends.

# node (as JSON text) -> the nodes its edges lead to, in input order
def _adj(from; to): group_by(from) | map({key: (.[0] | from | tojson), value: map(to)}) | from_entries;

# breadth-first search from $start: the nodes reached, the start first, in the order met, as
# [{node, hops, via (the node it was reached from; null for the start)}]. New nodes are recorded
# under their position in objects and sorted once at the end: an array growing by one inside the
# loop is copied each time, which made the search slow with the square of the graph.
def _search($adj; $start):
  {seen: {($start | tojson): [0, $start, 0, null]}, n: 1, frontier: [$start], level: 0}
  | until((.frontier | length) == 0;
      .frontier as $f | .level += 1 | .next = {}
      | reduce ($f[] as $u | $adj[$u | tojson][]? | [$u, .]) as $e (.;
          ($e[1] | tojson) as $k
          | if .seen[$k] != null then .
            else .seen[$k] = [.n, $e[1], .level, $e[0]] | .next[.n | tostring] = $e[1] | .n += 1 end)
      | .frontier = (.next | to_entries | sort_by(.key | tonumber) | map(.value)))
  | [.seen[]] | sort_by(.[0]) | map({node: .[1], hops: .[2], via: .[3]});

# reachable: every node that can be reached from $start along directed edges from -> to, at any
# number of hops, nearest first. $start itself is never listed, even when a cycle leads back to it:
# each node appears once and the start counts as already seen. Cycles are safe.
def reachable(from; to; $start): _adj(from; to) as $adj | _search($adj; $start) | .[1:] | map(.node);

# hops: one row per node that can be reached from $start along directed edges, the start itself
# included at 0: {node, hops}, where hops is the number of edges on the shortest route; nearest
# first, and within one distance in the order the search meets them.
def hops(from; to; $start): _adj(from; to) as $adj | _search($adj; $start) | map({node, hops});

# shortest_path, four arguments: the route from $start to $goal with the fewest edges, as
# {path: [the nodes from start to goal], cost: the number of edges}; null when there is none;
# {path: [$start], cost: 0} when they are the same node. Among routes of equal length, the one a
# breadth-first search following edges in input order finds first.
def shortest_path(from; to; $start; $goal):
  _adj(from; to) as $adj
  | (reduce _search($adj; $start)[] as $r ({}; .[$r.node | tojson] = $r)) as $ix
  | if $ix[$goal | tojson] == null then null
    else {path: ([$goal | recurse($ix[tojson].via | select(. != null))] | reverse), cost: $ix[$goal | tojson].hops}
    end;

# shortest_path, five arguments: the route with the lowest total weight (weights are numbers >= 0;
# anything else is an error), same output with cost the total. Among routes of equal cost, the one
# found first. It settles the nearest open node by scanning them all, with no priority queue: fine
# for a few thousand nodes, slow beyond.
def shortest_path(from; to; weight; $start; $goal):
  (first(.[] | (weight) | select(type != "number" or . < 0) | [.]) // null) as $bad
  | if $bad != null then error("shortest_path: an edge has weight \($bad[0] | tojson); weights must be numbers >= 0")
    else
    (group_by(from) | map({key: (.[0] | from | tojson), value: map([(to), (weight)])}) | from_entries) as $adj
    # d and open: node -> [cost, order found, node, via]
    | {d: {($start | tojson): [0, 0, $start, null]}, open: {($start | tojson): [0, 0, $start, null]}, done: {}, n: 1, stop: false}
    | until(.stop;
        (.open | [.[]] | if length == 0 then null else min_by([.[0], .[1]]) end) as $u
        | if $u == null or $u[2] == $goal then .stop = true
          else ($u[2] | tojson) as $uk
            | .open |= del(.[$uk]) | .done[$uk] = true
            | reduce $adj[$uk][]? as $e (.;
                ($e[0] | tojson) as $vk | ($u[0] + $e[1]) as $nd
                | if .done[$vk] then .
                  elif .d[$vk] == null then .d[$vk] = [$nd, .n, $e[0], $u[2]] | .open[$vk] = .d[$vk] | .n += 1
                  elif $nd < .d[$vk][0] then .d[$vk] = [$nd, .d[$vk][1], $e[0], $u[2]] | .open[$vk] = .d[$vk]
                  else . end)
          end)
    | .d as $d
    | if $d[$goal | tojson] == null then null
      else {path: ([$goal | recurse($d[tojson][3] | select(. != null))] | reverse), cost: $d[$goal | tojson][0]}
      end
    end;

# topo_order: a dependency order of the nodes of a directed graph. One row per node: {node, level},
# sorted by level then node: level 0 for a node nothing points to, otherwise one more than the
# highest level among the nodes that point to it, so every edge goes from a lower level to a higher
# one and the nodes of one level do not depend on each other. A cycle is an error naming a node on it.
def topo_order(from; to):
  ([.[] | (from), (to)] | unique) as $nodes
  | _adj(from; to) as $adj
  | (reduce .[] as $e (reduce $nodes[] as $n ({}; .[$n | tojson] = 0); .[$e | to | tojson] += 1)) as $deg0
  | . as $edges
  | {deg: $deg0, level: 0, frontier: [$nodes[] | select($deg0[tojson] == 0)], out: {}, k: 0, left: ($nodes | length)}
  | until((.frontier | length) == 0;
      .frontier as $f | .level as $lv
      | .out[.k | tostring] = ($f | map({node: ., level: $lv})) | .k += 1 | .left -= ($f | length) | .next = {}
      | reduce ($f[] | $adj[tojson][]?) as $v (.;
          ($v | tojson) as $vk | .deg[$vk] -= 1 | if .deg[$vk] == 0 then .next[$vk] = $v else . end)
      | .frontier = ([.next[]] | sort) | .level += 1)
  | if .left > 0
    then .deg as $deg
      # every node left has a node left pointing to it: walk back until one repeats; it is on a cycle
      | ($edges | map(select($deg[to | tojson] > 0 and $deg[from | tojson] > 0)) | _adj(to; from)) as $pred
      | ({cur: ([$nodes[] | select($deg[tojson] > 0)][0]), on: {}}
         | until(.on[.cur | tojson]; .on[.cur | tojson] = true | .cur = ($pred[.cur | tojson] | sort | .[0])) | .cur) as $c
      | error("topo_order: cycle through \($c | tojson)")
    else [.out[][]] | sort_by([.level, .node]) end;

# components: connected groups, edges read as undirected. One row per node: {node, component},
# where component is the smallest node of its group in jq's sort order. Rows sorted by node.
def components(a; b):
  ([.[] | [(a), (b)], [(b), (a)]] | group_by(.[0]) | map({key: (.[0][0] | tojson), value: map(.[1])}) | from_entries) as $adj
  | ([.[] | (a), (b)] | unique) as $nodes
  | reduce $nodes[] as $n ({seen: {}, parts: {}, k: 0};
      if .seen[$n | tojson] then .
      else (_search($adj; $n) | map(.node)) as $c
        | reduce $c[] as $m (.; .seen[$m | tojson] = true)
        | .parts[.k | tostring] = ($c | map({node: ., component: $n})) | .k += 1
      end)
  | [.parts[][]] | sort_by(.node);

# ---------------------------------------------------------------- measures in a context

# A measure is any jq function over an array of rows (def requests: length;). A report evaluates it
# in a context: the set of filters a cell stands for. rollup and rollup_levels run their cell
# argument once per group at every level, with this object as input:
#   {at: {level field: value}, rows: [the rows matching .at], all: [every row], level: [field names],
#    members: {field: sorted distinct values}, index: (private, rows by level and value)}
# Every level is a field on the row; put it there first (a computed field, or lookup).

# rows matching $at by scan. {field: value} is equality; {field: {from, to}} is a closed range that
# a null never satisfies. Used when a changed context is not one of the report's own levels.
def _where($at): map(select(. as $r | $at | to_entries | all(
  .key as $k | .value as $v | $r[$k] as $x
  | if ($v | type) == "object"
    then $x != null and ($v.from == null or $x >= $v.from) and ($v.to == null or $x <= $v.to)
    else $x == $v end)));

# the rows of the context given as input. A context whose fields are one of the report's levels is
# read from the index (no scan); one range on such a level is the union of that level's groups in
# the range, in order of the field's values. Anything else scans every row.
def _ctx_rows:
  . as $c
  | ($c.at | keys) as $ks
  | ($c.at | to_entries | map(select(.value | type == "object") | .key)) as $ranges
  | $c.index[$ks | tojson] as $ix
  | if $ix == null or ($ranges | length) > 1 then $c.all | _where($c.at)
    elif ($ranges | length) == 0 then $ix[[$c.at[$ks[]]] | tojson] // []
    else $ranges[0] as $d | $c.at[$d] as $v
      | [$c.members[$d][]
         | select(. != null and ($v.from == null or . >= $v.from) and ($v.to == null or . <= $v.to))
         | . as $m | $ix[[($c.at + {($d): $m})[$ks[]]] | tojson][]?]
    end;

# rollup_levels: one output row per group at each listed level. $levels is a list of field lists,
# for example [["region", "product"], ["region"], []]; [] is the grand total. Each output row is the
# level's fields, a level name ("region/product", or "all") and the fields of cell. Rows come level
# by level in the order listed, sorted by the level's values within a level. Nothing is added up
# from finer cells: every level is computed from rows, so a median or a ratio is right at the total.
# A row missing a level's field forms its own group (null). No input rows give no output rows.
def rollup_levels($levels; cell):
  . as $all
  | (reduce ($levels | add // [] | unique)[] as $d ({}; .[$d] = ($all | map(.[$d]) | unique))) as $members
  | (reduce ($levels + [[]])[] as $lvl ({};
       ((reduce $lvl[] as $d ({}; .[$d] = 1)) | keys) as $ks
       | if has($ks | tojson) then .
         else .[$ks | tojson] = ($all | group_by([.[$ks[]]]) | map({key: ([.[0][$ks[]]] | tojson), value: .}) | from_entries)
         end)) as $index
  | [$levels[] as $lvl
     | ((reduce $lvl[] as $d ({}; .[$d] = 1)) | keys) as $ks
     | [$index[$ks | tojson][] | . as $rows
        | {at: (reduce $lvl[] as $d ({}; .[$d] = $rows[0][$d])), rows: $rows}]
     | sort_by([.at[$lvl[]]])[]
     | {all: $all, members: $members, index: $index, at: .at, rows: .rows, level: $lvl}
     | .at + {level: (if $lvl == [] then "all" else ($lvl | join("/")) end)} + cell];

# rollup: the hierarchy of $dims: every field, then one fewer from the right, down to the grand
# total (SQL's GROUP BY ROLLUP). rollup(["region", "month"]; ...) gives region/month, region, all.
def rollup($dims; cell): rollup_levels([range($dims | length; -1; -1) as $n | $dims[0:$n]]; cell);

# inside a cell: measure f on the cell's own rows
def measure(f): .rows | f;

# inside a cell: measure f on the rows of a changed context (DAX's CALCULATE). change is one or
# more of without_filter, only_filters, with_filter, shift, to_date, piped. A shift past the first or last
# value has no context, and measure_with returns null without running f.
def measure_with(f; change): (change) as $c | if $c.void then null else ($c | _ctx_rows | f) end;

# inside a cell: measure f here divided by f in the changed context; null when that is null or 0
def share_of(f; change): measure(f) as $a | measure_with(f; change) as $b
  | if $a == null or $b == null or $b == 0 then null else $a / $b end;

# context changes. Each takes a context and returns one.
# remove one filter (ALL, REMOVEFILTERS). Written as .at |= del(...), not del(.at[$dim]): gojq's del
# copies the whole context, every row included, which cost 0.03 s per cell at 37,960 rows.
def without_filter($dim): .at |= del(.[$dim]);
def only_filters($dims): .at |= with_entries(select(.key as $k | $dims | any(. == $k)));   # ALLEXCEPT
def with_filter($at): .at += $at;                     # add or replace filters; a value or {from, to}

# By themselves shift and to_date follow the values present in the data, sorted as values: a month
# with no rows is skipped, and month names sort alphabetically. Pipe on_calendar (below) before them
# to step through calendar periods instead. For DAX's own time functions and blank rules, write the
# measure in DAX and compile it to SQL.
#
# move to the $k-th neighbouring value of $dim (-1 is the previous one). Neighbours are the field's
# distinct values over all rows, sorted, so "previous" is the previous value that has rows anywhere,
# not the previous calendar period. No filter on $dim (a total row) or no such neighbour: no context.
# A field that is not a level of the report has no list of values to step through: an error.
def shift($dim; $k):
  .at[$dim] as $v
  | if (.at | has($dim) | not) or $v == null or ($v | type) == "object" then .void = true
    elif .members[$dim] == null
    then error("shift: \($dim | tojson) is not a level of this report; add it to a level or use on_calendar")
    else (.members[$dim] | index($v)) as $i
    | if $i == null or $i + $k < 0 or $i + $k >= (.members[$dim] | length) then .void = true
      else .at[$dim] = .members[$dim][$i + $k] end
    end;

# on_calendar: make shift and to_date on $dim step through $values, in the order given, instead of
# through the values present in the data: measure_with(revenue; on_calendar("month"; $months) | shift("month"; -1))
# is the previous calendar month even when it has no rows (the measure then runs on no rows).
# $values is every period in order, for example calendar(...) | map(.year_month) | unique. A cell
# whose own value is not in $values has no context after a shift. to_date compares values, so the
# list has to sort the way it is ordered: "2026-03" does, "Mar" does not.
def on_calendar($dim; $values): .members[$dim] = $values;

# everything up to and including this value of $dim, other filters kept (a running total, DATESYTD
# when the year is another filter). No filter on $dim: unchanged.
def to_date($dim):
  if (.at | has($dim) | not) then .
  elif .at[$dim] == null then .void = true
  else .at[$dim] = {to: .at[$dim]} end;

# ---------------------------------------------------------------- shapes in and out

# Converters between the forms data arrives in and the shapes the functions above take, and from
# those shapes to what the next tool reads. docs/design/05-shapes.md defines the shapes.

# the distinct values of an array in order of first appearance (jq's unique sorts them)
# (each first sighting is stored with its position and the positions sorted at the end: appending
# to an array inside the reduce copied it every time, 47 s for 400,000 values)
def _distinct_in_order: reduce .[] as $x ({n: 0, s: {}}; ($x | tojson) as $k
  | if .s[$k] then . else .s[$k] = [.n, $x] | .n += 1 end) | [.s[]] | sort_by(.[0]) | map(.[1]);

# the array at f for one row: [] for null, an error naming the row for anything else
def _unnest_arr(f; $i):
  (f) as $a
  | if $a == null then [] elif ($a | type) == "array" then $a
    else error("unnest: row \($i) holds a \($a | type), not an array") end;

# unnest: one row per element of the array at f, the element in field $as. A row whose array is
# empty or null is dropped, as SQL's UNNEST drops it; unnest_outer keeps it once with $as null
# (LEFT JOIN LATERAL). A value at f that is neither an array nor null is an error naming the row's
# position. Elements come out in array order, rows in input order.
def unnest(f; $as):
  [to_entries[] | .key as $i | .value as $r | ($r | _unnest_arr(f; $i))[] as $x | $r + {($as): $x}];
def unnest_outer(f; $as):
  [to_entries[] | .key as $i | .value as $r
   | ($r | _unnest_arr(f; $i) | if length == 0 then [null] else . end)[] as $x | $r + {($as): $x}];

# one value flattened to {key: path, value} pairs; a non-empty object recurses, anything else is a leaf
def _flat($p; $sep):
  if type == "object" and length > 0
  then to_entries[] | .key as $k | .value | _flat(if $p == null then $k else $p + $sep + $k end; $sep)
  else {key: $p, value: .} end;

# flatten_fields: nested objects become columns named by their path joined with $sep
# ({"user": {"dept": "x"}} gives "user.dept"). Arrays and scalars are left as values, for unnest to
# take; an empty object stays as the value {}. Two paths that flatten to the same name are an error.
# (jq's own flatten flattens arrays; this flattens the objects inside each row.)
def flatten_fields($sep):
  map(if length == 0 then {}
      else [_flat(null; $sep)] as $e | ($e | from_entries) as $o
        | if ($o | length) != ($e | length)   # a repeated name collapsed in from_entries
          then error("flatten_fields: two fields flatten to the same name: \($e | map(.key) | group_by(.) | map(select(length > 1)[0]) | tojson)")
          else $o end
      end);

# one nested node and its descendants as rows, depth first, each with its parent's id
def _nodes(id; children; $p): . as $n
  | ($n | del(children) + {parent: $p}), ((($n | children) // [])[] | _nodes(id; children; ($n | id)));

# nodes_from_nested: a nested tree (each node holding its children in an array at `children`)
# becomes node rows, each with `parent` set to its parent's id (null for a root) and the children
# array removed. The input is one root object or an array of roots. Rows are in depth-first order.
def nodes_from_nested(id; children): [(if type == "array" then .[] else . end) | _nodes(id; children; null)];

# rows_from_map: an object keyed by id becomes rows, the key in field $as, sorted by key. A value
# that is not an object becomes {($as): key, value: v}. Sorted because gojq does not keep an
# object's key order, so the order the keys were written in cannot be the same on every engine.
# A value that already has a field named $as is an error: it would replace the key.
def rows_from_map($as):
  to_entries | sort_by(.key) | map(. as $e
    | if ($e.value | type) != "object" then {($as): $e.key, value: $e.value}
      elif ($e.value | has($as))
      then error("rows_from_map: the value of key \($e.key | tojson) already has a field \($as | tojson)")
      else {($as): $e.key} + $e.value end);

# fill_grid: every combination of the $keys fields' values (in first appearance) at every time from
# the earliest to the latest in steps of $step seconds; a missing combination gets a row with the
# key fields, the time field and $fill. $keys and $time are field names; times are epoch seconds
# and must sit on the grid (an offset from the earliest that is a multiple of $step), else an
# error. Without the filled rows a lag or a moving mean steps over an empty period as if it were
# the next one.
def fill_grid($keys; $time; $step; $fill):
  if length == 0 then []
  elif any(.[]; .[$time] == null) then error("fill_grid: a row has no time") else
  (map(.[$time]) | min) as $t0 | (map(.[$time]) | max) as $t1
  | (map(select(((.[$time] - $t0) % $step) != 0)) | if length > 0
       then error("fill_grid: \(.[0][$time]) is not on the \($step)-second grid from \($t0)") else . end) as $_
  | (reduce .[] as $r ({}; .[[$r[$keys[]], $r[$time]] | tojson] += [$r])) as $ix
  | ([.[] | [.[$keys[]]]] | _distinct_in_order) as $combos
  | [$combos[] as $k | range($t0; $t1 + 1; $step) as $t
     | ($ix[$k + [$t] | tojson] // [([$keys, $k] | transpose | map({key: .[0], value: .[1]}) | from_entries)
                                     + {($time): $t} + $fill])[]]
  end;

# to_map: rows become an object keyed by `key` (as a string). A duplicate key is an error; jq's
# own INDEX(key) keeps the last row silently.
def to_map(key):
  reduce .[] as $r ({}; ($r | key | tostring) as $k
    | if has($k) then error("to_map: duplicate key \($k | tojson)") else .[$k] = $r end);

# one node with its children, and theirs, nested under field $as
def _nest($by; id; $as): . as $n | $n + {($as): [($by[$n | id | tojson] // [])[] | _nest($by; id; $as)]};

# nested_from_nodes: node rows (id, parent) become a nested tree, each node's children in an array
# in field $as, the roots in an array. Checked with tree_paths first, so a missing parent or a
# cycle is the same error as there.
def nested_from_nodes(id; parent; $as):
  (tree_paths(id; parent) | length) as $_
  | (group_by(parent) | map({key: (.[0] | parent | tojson), value: .}) | from_entries) as $by
  | [.[] | select((parent) == null or (parent) == "") | _nest($by; id; $as)];

# node_link: edge rows become the node-link form graph tools read (networkx, d3, Cytoscape):
# {nodes: [{id}], links: [row + {source, target}]}. Nodes are in order of first appearance.
def node_link(from; to):
  {nodes: ([.[] | (from), (to)] | _distinct_in_order | map({id: .})),
   links: map(. + {source: (from), target: (to)})};

# to_csv: a header line, then one CSV line per row, columns in the order of $cols; a stream of
# strings, so run jq with -r. A null is an empty cell. A nested value in a cell is an error from
# @csv itself: flatten_fields first.
def to_csv($cols): ($cols | @csv), (.[] | [.[$cols[]]] | @csv);

# ---------------------------------------------------------------- intervals

# Intervals are rows with a key, a start and an end, [start, end): closed at the start, open at
# the end, as join_overlap reads them. A null end means still open.

# an event's kind must be one of the three and, when it has a kind, it needs a time
def _iv_check(time; kind):
  to_entries[] | .key as $i | .value | (kind) as $k
  | if $k == null then empty
    elif $k != "open" and $k != "hold" and $k != "release"
    then error("intervals_from_events: event \($i) has kind \($k | tojson); expected \"open\", \"hold\", \"release\" or null")
    elif (time) == null then error("intervals_from_events: event \($i) has a kind but no time")
    else empty end;

# intervals_from_events: validity intervals built from an event log. A resource (an address, a
# seat, a session id) has at most one holder at a time. For each event, `kind` gives "open" or
# "hold" (evidence that `holder` has `resource` at `time`: a grant, a renewal, a start, a
# keep-alive), "release" (the holder gives it up), or null (ignored). `ttl` gives how many seconds
# a hold stays valid without another one, or null when holds do not expire.
#   - A hold opens an interval, or extends the open one when it is from the same holder: its end
#     becomes the later of its end and time + ttl (null when this hold's ttl is null).
#   - An interval ends in exactly one way, in `ended_by`: "released" (a release from its holder, at
#     that time), "taken_over" (a hold from another holder while it is still valid, at that time),
#     "lapsed" (its end passed before the next event on the resource), or "open" (still open at the
#     end of the data; its end is the last hold + ttl, or null).
#   - At the same time on one resource, events apply in the order open, hold, release. A release from someone
#     who does not hold the resource, or when nothing is held, is ignored.
#   - `start_seen` is true when the interval's first event was "open": a "hold" may be a renewal of
#     something that began before the data does.
# `last` is the time of the interval's last hold: the last evidence, which is what there is to go
# on when an open interval has no end.
# One row per interval: {resource, holder, start, end, last, events, start_seen, ended_by}; resources in
# order of first appearance, intervals in time order. Intervals of one resource never overlap.
# A kind other than the three, or a null time on an event with a kind, is an error naming the event.
def intervals_from_events(resource; holder; time; kind; ttl):
  ([_iv_check(time; kind)] | length) as $_
  | [map(select((kind) != null)) | _groups(resource)[]
     | (.[0] | resource) as $res
     | sort_by([(time), ((kind) as $k | if $k == "open" then 0 elif $k == "hold" then 1 else 2 end)])
     # one pass; closed intervals leave through .out as they close, so nothing is appended to a
     # growing array. The trailing null is the end-of-data marker.
     | foreach (.[], null) as $e ({cur: null, out: []};
         .out = []
         | if $e == null then
             (if .cur != null then .out = [.cur + {ended_by: "open"}] | .cur = null else . end)
           else
             ($e | time) as $t | ($e | kind) as $k | ($e | holder) as $h | ($e | ttl) as $ttl
             | (if .cur != null and .cur.end != null and $t >= .cur.end
                then .out += [.cur + {ended_by: "lapsed"}] | .cur = null else . end)
             | if $k == "release" then
                 (if .cur != null and .cur.holder == $h
                  then .out += [.cur + {end: $t, ended_by: "released"}] | .cur = null else . end)
               elif .cur != null and .cur.holder == $h then
                 .cur.events += 1 | .cur.last = $t
                 | .cur.end = (if $ttl == null then null elif .cur.end == null then $t + $ttl
                               else ([.cur.end, $t + $ttl] | max) end)
               else
                 (if .cur != null then .out += [.cur + {end: $t, ended_by: "taken_over"}] else . end)
                 | .cur = {resource: $res, holder: $h, start: $t,
                           end: (if $ttl == null then null else $t + $ttl end),
                           last: $t, events: 1, start_seen: ($k == "open")}
               end
           end;
         .out[])];

# join_within (left outer): each left row with the interval of the same key whose [rstart, rend)
# contains the left row's ltime; a null rend means still open. No such interval, or a null key or
# time on the left: the left row alone. When several intervals of a key contain the time, the one
# that started last. Merged like every flat join: a field name on both sides that is not the
# key comes out twice, the right one with "_right". Use it for "who held this at T"; join_asof is for "the latest value at or before T".
def join_within($intervals; lkey; rkey; ltime; rstart; rend):
  1.7976931348623157e308 as $inf
  | _merge_plan(.; $intervals; lkey; rkey; "_right") as $plan
  | ([$intervals[] | select((rkey) != null and (rstart) != null)] | group_by(rkey)
     | map(sort_by(rstart)
           | {key: (.[0] | rkey | tojson),
              value: {rows: ., s: map(rstart), e: map((rend) // $inf)}}
           # m[i]: the latest end among rows 0..i, so a search going back can stop early
           | .value.m = [foreach .value.e[] as $x (null; if . == null or $x > . then $x else . end)])
     | from_entries) as $ix
  | [.[] as $l | ($l | lkey) as $k | ($l | ltime) as $t
     | if $k == null or $t == null or $ix[$k | tojson] == null then $l
       else $ix[$k | tojson] as $g
       | ($g.s | bsearch($t)) as $i
       | (if $i >= 0 then $i else -2 - $i end) as $at
       # the last start <= $t (bsearch may land on any of several equal starts)
       | ($at | until(. + 1 >= ($g.s | length) or $g.s[. + 1] > $t; . + 1)) as $last
       # go back until an interval contains $t, or no earlier one can
       | ($last | until(. < 0 or $g.e[.] > $t or $g.m[.] <= $t; . - 1)) as $c
       | if $c >= 0 and $g.e[$c] > $t then _merge($l; $g.rows[$c]; $plan) else $l end
       end];

# an interval needs a start, and an end that is not before it
def _iv_order_check(start; fin; $who):
  if any(.[]; (start) == null) then error("\($who): an interval has no start")
  elif any(.[]; (fin) != null and (fin) < (start)) then error("\($who): an interval ends before it starts") else . end;

# merge_intervals: per key, intervals that overlap or touch become one row
# {key..., start, end, merged (how many went in)}; keys in order of first appearance, intervals in
# time order. A null end is open-ended and absorbs everything of its key that starts after it.
def merge_intervals(key; start; fin):
  _iv_order_check(start; fin; "merge_intervals")
  | [_groups(key)[]
     | (.[0] | key | if type == "object" then . else {key: .} end) as $k
     | sort_by(start)
     | foreach (.[], null) as $r ({cur: null, out: []};
         .out = []
         | if $r == null then (if .cur != null then .out = [.cur] | .cur = null else . end)
           else ($r | start) as $s | ($r | fin) as $e
           | if .cur != null and (.cur.end == null or $s <= .cur.end)
             then .cur.merged += 1
                  | .cur.end = (if .cur.end == null or $e == null then null else ([.cur.end, $e] | max) end)
             else (if .cur != null then .out = [.cur] else . end)
                  | .cur = $k + {start: $s, end: $e, merged: 1}
             end
           end;
         .out[])];

# concurrency: how many intervals are open over time: one row {t, open} per moment the count
# changes, in time order (`end` is a jq keyword, so the parameter is called fin). An interval counts from its start up to, not including, its end; one
# with a null end never stops counting. The peak is `concurrency(...) | max_by(.open)`.
def concurrency(start; fin):
  _iv_order_check(start; fin; "concurrency")
  | [.[] | {t: (start), d: 1}, ((fin) as $e | if $e == null then empty else {t: $e, d: -1} end)]
  | group_by(.t)
  | [foreach .[] as $g ({open: 0};
       ($g | map(.d) | add) as $net | {open: (.open + $net), t: $g[0].t, net: $net};
       select(.net != 0) | {t, open})];

# ---------------------------------------------------------------- calendar

def _cal_bad($who): error("\($who): \(tojson) is not a date (YYYY-MM-DD)");
# "YYYY-MM-DD" as epoch seconds of that day's midnight UTC; an impossible date (2026-02-30) is an error
def _cal_date($who):
  . as $s
  | if type != "string" or (test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") | not) then _cal_bad($who)
    else (try (($s + "T00:00:00Z") | fromdateiso8601) catch null) as $e
    | if $e == null or ($e | gmtime | strftime("%Y-%m-%d")) != $s then ($s | _cal_bad($who)) else $e end
    end;
def _cal_p: (. + (. / 4 | floor) - (. / 100 | floor) + (. / 400 | floor)) % 7;
def _cal_iso_weeks: if _cal_p == 4 or ((. - 1) | _cal_p) == 3 then 53 else 52 end;   # ISO weeks in year .
def _cal_pad2: if . < 10 then "0\(.)" else tostring end;
# the moment whose local clock in zone $z reads the UTC date of the input at 00:00; the second step
# corrects a first guess that fell on the other side of a clock change
def _cal_midnight($z): . as $m | ($m - ($m | tz_offset($z))) as $e | $m - ($e | tz_offset($z));

# calendar: one row per day from $from to $to inclusive (both "YYYY-MM-DD"), ignoring its input:
#   {date, year, quarter, month, day, weekday (0 = Sunday), day_of_year,
#    iso_year, iso_week   (weeks start Monday; week 1 holds the year's first Thursday; a day near
#                          New Year can belong to the neighbouring ISO year),
#    us_week              (weeks start Sunday; week 1 holds 1 January: a spreadsheet's WEEKNUM(d, 1)),
#    year_month "2026-03", year_quarter "2026-Q1", iso_year_week "2026-W09",
#    start, end}          epoch seconds of local midnight in $zone (a name or tz($name)) at the
#                         day's start and end, so a day is the interval [start, end): 23 or 25
#                         hours long when the clocks change, and join_within puts an event in its day.
# calendar($from; $to) is in UTC. Not a date, $from after $to, or an unknown zone: an error.
def calendar($from; $to; $zone):
  ($zone | if type == "string" then tz(.) else . end) as $z
  | ($from | _cal_date("calendar")) as $d0 | ($to | _cal_date("calendar")) as $d1
  | if $d0 > $d1 then error("calendar: from \($from | tojson) is after to \($to | tojson)")
    else
    [range(0; (($d1 - $d0) / 86400 | round) + 1) as $i
     | ($d0 + 86400 * $i) as $m | ($m | gmtime) as $g
     | ($g[0] | round) as $y | (($g[1] | round) + 1) as $mo | ($g[6] | round) as $wd | (($g[7] | round) + 1) as $doy
     | (if $wd == 0 then 7 else $wd end) as $dow
     | ((($doy - $dow + 10) / 7) | floor) as $w
     | (if $w < 1 then {y: ($y - 1), w: (($y - 1) | _cal_iso_weeks)}
        elif $w > ($y | _cal_iso_weeks) then {y: ($y + 1), w: 1}
        else {y: $y, w: $w} end) as $iso
     | ((($wd - ($doy - 1)) % 7 + 7) % 7) as $jan1
     | ((($mo - 1) / 3 | floor) + 1) as $q
     | {date: ($g | strftime("%Y-%m-%d")), year: $y, quarter: $q, month: $mo, day: ($g[2] | round),
        weekday: $wd, day_of_year: $doy, iso_year: $iso.y, iso_week: $iso.w,
        us_week: ((($doy + $jan1 - 1) / 7 | floor) + 1),
        year_month: "\($y)-\($mo | _cal_pad2)", year_quarter: "\($y)-Q\($q)",
        iso_year_week: "\($iso.y)-W\($iso.w | _cal_pad2)",
        start: ($m | _cal_midnight($z)), end: (($m + 86400) | _cal_midnight($z))}]
    end;
def calendar($from; $to): calendar($from; $to; "UTC");

# ---------------------------------------------------------------- event paths: funnels, cohorts, retention

def _entity_key: if type == "object" then . else {key: .} end;

def _funnel_check(time; step; $steps):
  if ($steps | length) == 0 then error("funnel: the step list is empty")
  elif ($steps | unique | length) != ($steps | length)
  then error("funnel: step \($steps | group_by(.) | map(select(length > 1)[0])[0] | tojson) is listed twice")
  else (first(.[] | select((step) as $s | any($steps[]; . == $s) and (time) == null) | [step]) // null) as $bad
    | if $bad != null then error("funnel: an event of step \($bad[0] | tojson) has no time") else . end
  end;

# funnel_steps: how far each entity gets through the ordered steps in $steps. An entity reaches
# step n when it has events for steps 1 to n in time order (a later step at the same time as the
# one before counts). With $within (seconds; null for no limit) every step must happen within that
# long of the entity's first step, and the entity is credited with the deepest chain any of its
# first-step events can start: an early first step that times out does not hide a later one that
# completes. One row per entity that reaches step 1, entities in order of first appearance:
# {entity key..., depth (1 to the number of steps), times (the time of each step reached)}.
# Events whose step is not listed are ignored. An empty step list, a step listed twice, or a null
# time on an event of a listed step is an error.
def funnel_steps(entity; time; step; $steps; $within):
  _funnel_check(time; step; $steps)
  | ($steps | length) as $n
  | [map(select((step) as $s | any($steps[]; . == $s))) | _groups(entity)[]
     | (.[0] | entity | _entity_key) as $k
     | (. as $ev | [$steps[] as $s | [$ev[] | select((step) == $s) | time] | sort]) as $t
     | (reduce $t[0][] as $t1 (null;
          if . != null and length == $n then .
          else (if $within == null then null else $t1 + $within end) as $lim
            # for a fixed first event the earliest matching event is always the best next step:
            # a later one can only remove options for the steps after it
            | (reduce range(1; $n) as $i ({c: [$t1], ok: true};
                 if .ok | not then .
                 else .c[-1] as $prev
                   | (first($t[$i][] | select(. >= $prev and ($lim == null or . <= $lim)) | [.]) // null) as $x
                   | if $x == null then .ok = false else .c += $x end
                 end) | .c) as $chain
            | if . == null or ($chain | length) > length then $chain else . end
          end)) as $best
     | select($best != null) | $k + {depth: ($best | length), times: $best}];

# funnel: one row per step, in order: {step, entities (how many reached it), from_previous,
# from_first}: the count divided by the previous step's and by the first step's; null where the
# divisor is zero, and from_previous is null on the first step. A funnel only narrows.
def funnel(entity; time; step; $steps; $within):
  (funnel_steps(entity; time; step; $steps; $within) | map(.depth)) as $d
  | [range(0; $steps | length) as $i | ($d | map(select(. > $i)) | length)] as $c
  | [range(0; $steps | length) as $i
     | {step: $steps[$i], entities: $c[$i],
        from_previous: (if $i == 0 or $c[$i - 1] == 0 then null else $c[$i] / $c[$i - 1] end),
        from_first: (if $c[0] == 0 then null else $c[$i] / $c[0] end)}];

def _period_pos: . as $p | reduce range(0; length) as $i ({}; .[$p[$i] | tojson] = $i);
def _period_idx(period; $pos; $who):
  (period) as $p | $pos[$p | tojson] as $i
  | if $i == null then error("\($who): period \($p | tojson) is not in the period list") else $i end;

# cohorts: one row per entity, in order of first appearance: {entity key..., cohort}, the earliest
# period, in $periods order, in which it has an event. $periods is every period in order, for
# example calendar(...) | map(.year_month) | unique. A period not in the list is an error.
def cohorts(entity; period; $periods):
  ($periods | _period_pos) as $pos
  | [_groups(entity)[] | (.[0] | entity | _entity_key) + {cohort: $periods[map(_period_idx(period; $pos; "cohorts")) | min]}];

# retention: of the entities first seen in a period (a cohort), how many have at least one event
# in each later period. One row per cohort and period, from the cohort's own period to the last in
# $periods: {cohort, period, offset (periods after the cohort's; 0 for its own), entities,
# cohort_size, rate (entities / cohort_size)}. The table is complete: a period in which nobody of
# the cohort is active has a row with 0. Periods with no first-time entities form no cohort.
def retention(entity; period; $periods):
  ($periods | _period_pos) as $pos
  | [_groups(entity)[] | map(_period_idx(period; $pos; "retention")) | {c: min, a: unique}] as $e
  | ($periods | length) as $np
  | ($e | group_by(.c) | map({key: (.[0].c | tostring), value: .}) | from_entries) as $byc
  | [range(0; $np) as $c | ($byc[$c | tostring] // []) as $m | select(($m | length) > 0)
     | ($m | [.[].a[]] | group_by(.) | map({key: (.[0] | tostring), value: length}) | from_entries) as $cnt
     | range($c; $np) as $p | ($cnt[$p | tostring] // 0) as $n
     | {cohort: $periods[$c], period: $periods[$p], offset: ($p - $c), entities: $n,
        cohort_size: ($m | length), rate: ($n / ($m | length))}];

# ---------------------------------------------------------------- distributions, profiles, diffs

# mode: the most frequent non-null value of a list; among equally frequent values the smallest in
# jq's sort order; null when there is none.
def mode: nonnull | if length == 0 then null else group_by(.) | map([-length, .[0]]) | min | .[1] end;

# value_counts: one row per distinct non-null value of a list: {value, count, share (of the non-null
# values)}, most frequent first, ties by value.
def value_counts:
  nonnull | length as $n | group_by(.) | map({value: .[0], count: length, share: (length / $n)}) | sort_by([-.count, .value]);

# bin_edges: $n + 1 equally spaced numbers from $lo to $hi, the edges of $n bins
def bin_edges($lo; $hi; $n):
  if ($hi > $lo and $n >= 1) | not then error("bin_edges: need hi > lo and n >= 1")
  else [range(0; $n + 1) | $lo + ($hi - $lo) * . / $n] end;

# histogram: counts of a list of numbers per bin, the bins given by their edges (bin_edges, or any
# increasing list): one row per bin {from, to, count}. A bin holds from <= v < to, and the last bin
# also holds v == to, as numpy's histogram does. Nulls are skipped. A value outside the edges is an
# error, not a dropped value; so are edges that are not at least two increasing numbers.
def histogram($edges):
  ($edges | length) as $k
  | if $k < 2 or ($edges | any(type != "number")) or ([range(1; $k) | select($edges[.] <= $edges[. - 1])] | length) > 0
    then error("histogram: edges must be at least two increasing numbers")
    else
    (reduce (nonnull[]) as $v ({};
       if ($v | type) != "number" or $v < $edges[0] or $v > $edges[$k - 1]
       then error("histogram: value \($v | tojson) is outside the edges")
       else ($edges | bsearch($v)) as $i
         | (if $i < 0 then -2 - $i elif $i == $k - 1 then $i - 1 else $i end) as $b
         | .[$b | tostring] += 1
       end)) as $c
    | [range(0; $k - 1) | {from: $edges[.], to: $edges[. + 1], count: ($c[tostring] // 0)}]
    end;

# corr: Pearson's correlation of x and y over the rows where both are non-null; null with fewer than
# two such rows, or when either side does not vary. Matches SQL's corr.
def corr(x; y):
  [.[] | [(x), (y)] | select(.[0] != null and .[1] != null)] as $p
  | ($p | length) as $n
  | if $n < 2 then null
    else (($p | map(.[0]) | add) / $n) as $mx | (($p | map(.[1]) | add) / $n) as $my
    | (reduce $p[] as $q ([0, 0, 0];
         ($q[0] - $mx) as $dx | ($q[1] - $my) as $dy | [.[0] + $dx * $dy, .[1] + $dx * $dx, .[2] + $dy * $dy])) as $s
    | if $s[1] == 0 or $s[2] == 0 then null else $s[0] / (($s[1] * $s[2]) | sqrt) end
    end;

# profile: one row per column of a table, columns in name order:
#   {column, rows (rows in the table), present (rows that have the field), nulls (rows where it is
#    null or absent), empty (rows where it is ""), distinct (distinct non-null values),
#    types (jq type name -> count, over the rows that have the field),
#    min, max (the smallest and largest non-null value when all non-null values are numbers or all
#    are strings; null otherwise)}
def profile:
  . as $rows | length as $n
  | ([.[] | keys[]] | unique) as $cols
  | [$cols[] as $c
     | [$rows[] | select(has($c)) | .[$c]] as $pv
     | ($pv | map(select(. != null))) as $nn
     | ($nn | map(type) | unique) as $ts
     | {column: $c, rows: $n, present: ($pv | length), nulls: ($n - ($nn | length)),
        empty: ($nn | map(select(. == "")) | length), distinct: ($nn | unique | length),
        types: ($pv | group_by(type) | map({key: (.[0] | type), value: length}) | from_entries),
        min: (if $ts == ["number"] or $ts == ["string"] then ($nn | min) else null end),
        max: (if $ts == ["number"] or $ts == ["string"] then ($nn | max) else null end)}];

def _diff_index(key; $who):
  reduce .[] as $r ({}; ($r | key) as $k
    | if $k == null then error("diff_tables: a row of the \($who) table has a null key")
      elif has($k | tojson) then error("diff_tables: key \($k | tojson) appears twice in the \($who) table")
      else .[$k | tojson] = $r end);

# diff_tables: what changed between two versions of a table that share a key. The input is the new
# table, $old the old one. One row per key that was added, removed or changed, sorted by key:
# {key, change ("added", "removed" or "changed"), fields (for a changed row, the fields whose values
# differ, in name order; a field present on one side only counts), old, new (the rows; null on the
# side that has none)}. Unchanged rows are left out. A key that appears twice in either table, or
# a null key, is an error.
def diff_tables($old; key):
  _diff_index(key; "new") as $n | ($old | _diff_index(key; "old")) as $o
  | ([.[] | key] + [$old[] | key] | unique) as $ks
  | [$ks[] as $k | ($k | tojson) as $j | $n[$j] as $a | $o[$j] as $b
     | if $b == null then {key: $k, change: "added", fields: [], old: null, new: $a}
       elif $a == null then {key: $k, change: "removed", fields: [], old: $b, new: null}
       elif $a == $b then empty
       else {key: $k, change: "changed",
             fields: ([($a | keys[]), ($b | keys[])] | unique
                      | map(select(. as $f | ($a | has($f)) != ($b | has($f)) or $a[$f] != $b[$f]))),
             old: $b, new: $a}
       end];

# ---------------------------------------------------------------- approximate matching

# Clean the key first: most keys that should match differ by case, spacing or punctuation, and an
# ordinary join on a cleaned key expression (join_inner($r; (.name | ascii_downcase); ...)) handles
# them at no extra cost. What follows is for small tables where that is not enough: similarity
# compares about 11,000 pairs a second and join_fuzzy about 30,000 (it computes each right row's
# bigrams once). For edit distance, or for millions of comparisons, use a database: jq runs an edit
# distance about a thousand times slower than DuckDB.

# the distinct two-character slices of a string, sorted
def _bigrams:
  if type != "string" then error("similarity: \(tojson) is not a string")
  else explode as $c | [range(0; ($c | length) - 1) | $c[.:. + 2] | implode] | unique end;
def _dice($x; $y):
  if ($x | length) == 0 or ($y | length) == 0 then 0
  else 2 * (($x - ($x - $y)) | length) / (($x | length) + ($y | length)) end;

# similarity: how alike two strings are, from 0 to 1: the Dice coefficient over their distinct
# character bigrams (twice the bigrams they share, divided by the bigrams of both). Equal strings
# give 1, including strings too short to have a bigram; null on either side gives null. It compares
# what it is given: lowercase and trim in the expressions if that is wanted.
def similarity(a; b):
  (a) as $a | (b) as $b
  | if $a == null or $b == null then null
    elif ($a | type) != "string" then ($a | _bigrams) elif ($b | type) != "string" then ($b | _bigrams)
    elif $a == $b then 1
    else _dice($a | _bigrams; $b | _bigrams) end;

# join_fuzzy (left outer): each left row with field $as holding {similarity, row} for the right row
# of the same block whose rstr is most similar to the left row's lstr, when that similarity is at
# least $min; null otherwise. lblock and rblock give an exact key two rows must share to be
# compared at all (a site, a first letter): the cost is one comparison per pair of rows that share
# a block, so choose blocks that stay small. Among equally similar right rows, the first in input
# order. A null block or a null string never matches.
def join_fuzzy($right; lblock; rblock; lstr; rstr; $min; $as):
  ([$right[] | select((rblock) != null and (rstr) != null) | {b: (rblock | tojson), s: (rstr), g: (rstr | _bigrams), r: .}]
   | group_by(.b) | map({key: .[0].b, value: .}) | from_entries) as $ix
  | map(. as $l | ($l | lblock) as $bk | ($l | lstr) as $s
      | (if $bk == null or $s == null then null
         else ($s | _bigrams) as $g
           | reduce ($ix[$bk | tojson] // [])[] as $c (null;
               (if $c.s == $s then 1 else _dice($g; $c.g) end) as $sim
               | if $sim >= $min and (. == null or $sim > .similarity) then {similarity: $sim, row: $c.r} else . end)
         end) as $m
      | $l + {($as): $m});
